# Janus Prop AI Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
APP_NAME=Janus Prop AI Backend
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# =====================================================
# SERVER CONFIGURATION
# =====================================================
HOST=0.0.0.0
PORT=8000
WORKERS=1

# =====================================================
# CORS CONFIGURATION
# =====================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# Choose either Supabase or Local PostgreSQL

# Local PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/janus_prop_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false
DATABASE_ECHO_POOL=false

# Supabase Configuration (Recommended)
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# =====================================================
# FRONTEND CONFIGURATION (VITE_ prefixed variables)
# =====================================================
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_ENABLE_AGENT_CONSOLE=true
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# =====================================================
# REDIS CONFIGURATION
# =====================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =====================================================
# EMAIL CONFIGURATION
# =====================================================
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Janus Prop AI

# =====================================================
# FILE STORAGE CONFIGURATION
# =====================================================
STORAGE_TYPE=local
STORAGE_BUCKET=
STORAGE_REGION=

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ENDPOINT_URL=

# Google Cloud Storage Configuration
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CREDENTIALS_FILE=

# Azure Blob Storage Configuration
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER_NAME=

# =====================================================
# AI API KEYS
# =====================================================
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# =====================================================
# REAL ESTATE API KEYS
# =====================================================
ZILLOW_API_KEY=your_zillow_api_key_here
REDFIN_API_KEY=your_redfin_api_key_here
REALTOR_API_KEY=your_realtor_api_key_here
ATTOM_API_KEY=your_attom_api_key_here
ESTATED_API_KEY=your_estated_api_key_here
FRED_API_KEY=your_fred_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
API_KEY=your_generic_api_key_here

# Additional Real Estate APIs
MLS_API_KEY=your_mls_api_key_here
PROPERTY_DATA_API_KEY=your_property_data_api_key_here
REALTY_MOLE_API_KEY=your_realty_mole_api_key_here
RENT_SPREE_API_KEY=your_rent_spree_api_key_here

# =====================================================
# LANGCHAIN CONFIGURATION
# =====================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=janus-prop-ai

# =====================================================
# SECURITY CONFIGURATION
# =====================================================
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_EXPIRATION_HOURS=24
PASSWORD_HASH_ROUNDS=12

# =====================================================
# RATE LIMITING
# =====================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=200
RATE_LIMIT_ENABLED=true

# =====================================================
# LOGGING CONFIGURATION
# =====================================================
LOG_LEVEL=INFO
LOG_FILE=
LOG_MAX_SIZE=100
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =====================================================
# AGENT CONFIGURATION
# =====================================================
MAX_CONCURRENT_AGENTS=10
MAX_CONCURRENT_AGENT_TASKS=5
AGENT_TIMEOUT=300
AGENT_HEARTBEAT_TIMEOUT=300
AGENT_HEALTH_CHECK_INTERVAL=30
AGENT_MEMORY_SIZE=1000

# =====================================================
# REAL-TIME CONFIGURATION
# =====================================================
WEBSOCKET_HEARTBEAT_INTERVAL=30
REALTIME_UPDATE_INTERVAL=5
WEBSOCKET_MAX_CONNECTIONS=1000

# =====================================================
# DATA PROCESSING
# =====================================================
MAX_PROPERTIES_PER_REQUEST=1000
DATA_SYNC_INTERVAL=300
CACHE_TTL_SECONDS=1800
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
DATA_BATCH_SIZE=100

# =====================================================
# FILE UPLOAD CONFIGURATION
# =====================================================
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx
MAX_FILES_PER_UPLOAD=10

# =====================================================
# MONITORING AND METRICS
# =====================================================
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics
HEALTH_CHECK_PATH=/health

# =====================================================
# EXTERNAL SERVICES
# =====================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# =====================================================
# BACKGROUND TASKS
# =====================================================
ENABLE_BACKGROUND_TASKS=true
BACKGROUND_TASK_WORKERS=4
BACKGROUND_TASK_MAX_RETRIES=3
BACKGROUND_TASK_RETRY_DELAY=60

# =====================================================
# SEARCH CONFIGURATION
# =====================================================
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=janus_prop_ai

# =====================================================
# NOTIFICATION CONFIGURATION
# =====================================================
ENABLE_NOTIFICATIONS=true
NOTIFICATION_CHANNELS=email,webhook
WEBHOOK_URL=
WEBHOOK_SECRET=

# =====================================================
# FEATURE FLAGS
# =====================================================
ENABLE_AI_FEATURES=true
ENABLE_PROPERTY_ANALYSIS=true
ENABLE_MARKET_INSIGHTS=true
ENABLE_PREDICTIVE_MODELING=true

# =====================================================
# API VERSIONING
# =====================================================
API_VERSION=v1
API_PREFIX=/api

# =====================================================
# PERFORMANCE CONFIGURATION
# =====================================================
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_TIMEOUT=300
REQUEST_TIMEOUT=30

# =====================================================
# DEVELOPMENT CONFIGURATION
# =====================================================
ENABLE_SWAGGER=true
ENABLE_RELOAD=false
ENABLE_DEBUG_TOOLBAR=false
