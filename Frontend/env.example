# Janus Prop AI Frontend Environment Configuration
# Copy this file to .env.local for development or .env.production for production

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
VITE_APP_NAME=Janus Prop AI
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Advanced Real Estate AI Platform
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# =====================================================
# API CONFIGURATION
# =====================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_VERSION=v1

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id_here

# =====================================================
# FEATURE FLAGS
# =====================================================
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_ENABLE_AGENT_CONSOLE=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_PROPERTY_ANALYSIS=true
VITE_ENABLE_MARKET_INSIGHTS=true
VITE_ENABLE_PREDICTIVE_MODELING=true
VITE_ENABLE_DATA_INTEGRATION=true
VITE_ENABLE_AI_INSIGHTS=true

# =====================================================
# UI CONFIGURATION
# =====================================================
VITE_THEME=system
VITE_ANIMATIONS=true
VITE_COMPACT_MODE=false
VITE_RESPONSIVE_BREAKPOINTS=true

# =====================================================
# REAL-TIME CONFIGURATION
# =====================================================
VITE_WEBSOCKET_URL=ws://localhost:8000/ws
VITE_WEBSOCKET_RECONNECT_INTERVAL=5000
VITE_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5
VITE_REALTIME_UPDATE_INTERVAL=5000

# =====================================================
# AGENT CONFIGURATION
# =====================================================
VITE_AGENT_POLLING_INTERVAL=10000
VITE_AGENT_MAX_ACTIVITIES=50
VITE_AGENT_CONNECTION_CHECK_INTERVAL=30000
VITE_AGENT_HEARTBEAT_INTERVAL=30000

# =====================================================
# DATA CONFIGURATION
# =====================================================
VITE_MAX_PROPERTIES_PER_REQUEST=1000
VITE_DATA_SYNC_INTERVAL=300000
VITE_CACHE_TTL_SECONDS=1800
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# =====================================================
# PERFORMANCE CONFIGURATION
# =====================================================
VITE_ENABLE_COMPRESSION=true
VITE_ENABLE_CACHING=true
VITE_CACHE_TIMEOUT=300
VITE_REQUEST_TIMEOUT=30000
VITE_LAZY_LOADING=true
VITE_CODE_SPLITTING=true

# =====================================================
# SECURITY CONFIGURATION
# =====================================================
VITE_ENABLE_CSRF_PROTECTION=true
VITE_ENABLE_XSS_PROTECTION=true
VITE_ENABLE_CONTENT_SECURITY_POLICY=true
VITE_SESSION_TIMEOUT=1800000

# =====================================================
# MONITORING CONFIGURATION
# =====================================================
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_ENABLE_ERROR_REPORTING=true

# =====================================================
# DEVELOPMENT CONFIGURATION
# =====================================================
VITE_ENABLE_HOT_RELOAD=true
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_MOCK_DATA=false
VITE_MOCK_API_DELAY=1000

# =====================================================
# EXTERNAL SERVICES
# =====================================================
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PAYPAL_CLIENT_ID=

# =====================================================
# REAL ESTATE API CONFIGURATION
# =====================================================
VITE_ENABLE_ZILLOW_INTEGRATION=false
VITE_ENABLE_REDFIN_INTEGRATION=false
VITE_ENABLE_REALTOR_INTEGRATION=false
VITE_ENABLE_ATTOM_INTEGRATION=false
VITE_ENABLE_ESTATED_INTEGRATION=false
VITE_ENABLE_FRED_INTEGRATION=false

# =====================================================
# NOTIFICATION CONFIGURATION
# =====================================================
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_ENABLE_EMAIL_NOTIFICATIONS=true
VITE_ENABLE_SMS_NOTIFICATIONS=false
VITE_NOTIFICATION_POLLING_INTERVAL=60000

# =====================================================
# FILE UPLOAD CONFIGURATION
# =====================================================
VITE_MAX_FILE_SIZE=52428800
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx
VITE_MAX_FILES_PER_UPLOAD=10
VITE_UPLOAD_CHUNK_SIZE=1048576

# =====================================================
# SEARCH CONFIGURATION
# =====================================================
VITE_ENABLE_ELASTICSEARCH=false
VITE_ELASTICSEARCH_URL=
VITE_SEARCH_DEBOUNCE_DELAY=300
VITE_SEARCH_MIN_QUERY_LENGTH=2
VITE_SEARCH_MAX_RESULTS=50

# =====================================================
# INTERNATIONALIZATION
# =====================================================
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,es,fr
VITE_ENABLE_I18N=false

# =====================================================
# ACCESSIBILITY
# =====================================================
VITE_ENABLE_ACCESSIBILITY=true
VITE_ENABLE_KEYBOARD_NAVIGATION=true
VITE_ENABLE_SCREEN_READER_SUPPORT=true
VITE_HIGH_CONTRAST_MODE=false
